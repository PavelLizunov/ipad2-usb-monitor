+static int readtight(int fd, int x, int y, int w, int h)
+{
+	u8 control;
+	if (bpp != 4 || vread(fd, &control, 1) < 0) return -1;
+	for (int i = 0; i < 4; i++)
+		if ((control & (1 << i)) && tight_ready[i])
+			inflateReset(&tight_streams[i]);
+	int type = control >> 4;
+	if (type == 8) {
+		u8 rgb[3], pixel[4];
+		if (vread(fd, rgb, 3) < 0) return -1;
+		pixel[0] = rgb[2]; pixel[1] = rgb[1]; pixel[2] = rgb[0]; pixel[3] = 255;
+		fillrect((char *)pixel, x, y, w, h);
+		return 0;
+	}
+	if (type == 9) {
+		int length = compact_size(fd), width, height, subsampling, colorspace;
+		if (length <= 0 || length > w * h * 4 + 65536) return -1;
+		unsigned char *data = malloc(length);
+		if (!data) return -1;
+		int result = -1;
+		if (vread(fd, data, length) < 0) goto jpeg_done;
+		if (!jpeg_decoder) jpeg_decoder = tjInitDecompress();
+		if (!jpeg_decoder || tjDecompressHeader3(jpeg_decoder, data, length,
+			&width, &height, &subsampling, &colorspace) < 0 || width != w || height != h)
+			goto jpeg_done;
+		result = tjDecompress2(jpeg_decoder, data, length,
+			(unsigned char *)RFB(x, y), w, srv_cols * bpp, h,
+			TJPF_BGRA, TJFLAG_FASTDCT | TJFLAG_FASTUPSAMPLE);
+	jpeg_done:
+		free(data);
+		return result;
+	}
+	if (type > 7) return -1;
+	if (type & 4) {
+		u8 filter;
+		if (vread(fd, &filter, 1) < 0 || filter != 0) return -1;
+	}
+	int size = w * h * 3;
+	unsigned char *pixels = malloc(size + 1);
+	if (!pixels) return -1;
+	int result = -1;
+	if (size < 12) {
+		if (vread(fd, pixels, size) < 0) goto basic_done;
+	} else {
+		int length = compact_size(fd), index = type & 3;
+		if (length <= 0 || length > size + 65536) goto basic_done;
+		unsigned char *compressed = malloc(length);
+		if (!compressed) goto basic_done;
+		if (vread(fd, compressed, length) < 0) { free(compressed); goto basic_done; }
+		z_stream *stream = &tight_streams[index];
+		if (!tight_ready[index]) {
+			if (inflateInit(stream) != Z_OK) { free(compressed); goto basic_done; }
+			tight_ready[index] = 1;
+		}
+		stream->next_in = compressed; stream->avail_in = length;
+		stream->next_out = pixels; stream->avail_out = size + 1;
+		int status = inflate(stream, Z_SYNC_FLUSH);
+		int valid = (status == Z_OK || status == Z_BUF_ERROR) &&
+			stream->avail_in == 0 && stream->avail_out == 1;
+		free(compressed);
+		if (!valid) goto basic_done;
+	}
+	unsigned char *src = pixels;
+	for (int row = 0; row < h; row++) {
+		unsigned char *dst = (unsigned char *)RFB(x, y + row);
+		int col = 0;
+#ifdef __ARM_NEON
+		for (; col + 16 <= w; col += 16, src += 48, dst += 64) {
+			uint8x16x3_t rgb = vld3q_u8(src);
+			uint8x16x4_t bgra;
+			bgra.val[0] = rgb.val[2]; bgra.val[1] = rgb.val[1];
+			bgra.val[2] = rgb.val[0]; bgra.val[3] = vdupq_n_u8(255);
+			vst4q_u8(dst, bgra);
+		}
+#endif
+		for (; col < w; col++, src += 3, dst += 4) {
+			dst[0] = src[2]; dst[1] = src[1]; dst[2] = src[0]; dst[3] = 255;
+		}
+	}
+	result = 0;
+basic_done:
+	free(pixels);
+	return result;
+}
